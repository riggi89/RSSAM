<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RSSAMArchitecture>x64</RSSAMArchitecture>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SelfContained>false</SelfContained>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\RSSAM.UnitTests.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RSSAM.Core\RSSAM.Core.csproj"
                      ReferenceOutputAssembly="true"
                      Private="true" />
    <ProjectReference Include="..\..\src\RSSAM.API\RSSAM.API.csproj"
                      ReferenceOutputAssembly="true"
                      Private="true" />
  </ItemGroup>

  <!--
    Visual Studio can execute the test assembly from a deployment directory
    that is populated from the resolved copy-local items. Keep the two RSSAM
    runtime assemblies explicit here as well as in the ProjectReference graph.
    ReferenceCopyLocalPaths contains implementation assemblies intended for
    execution, unlike compiler-only files below obj\...\ref.
  -->
  <Target Name="CopyUnitTestRuntimeProjectOutputs"
          AfterTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <_UnitTestRuntimeProjectOutput
        Include="@(ReferenceCopyLocalPaths)"
        Condition="'%(Filename)' == 'RSSAM.Core' Or '%(Filename)' == 'RSSAM.API'" />
    </ItemGroup>

    <Error Condition="'@(_UnitTestRuntimeProjectOutput)' == ''"
           Text="The RSSAM runtime project outputs could not be resolved for the UnitTests project." />

    <Copy SourceFiles="@(_UnitTestRuntimeProjectOutput)"
          DestinationFiles="@(_UnitTestRuntimeProjectOutput->'$(TargetDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ValidateUnitTestDependencies" AfterTargets="Build">
    <Error Condition="!Exists('$(TargetDir)RSSAM.Core.dll')"
           Text="RSSAM.Core.dll was not copied to the UnitTests output directory: $(TargetDir)" />
    <Error Condition="!Exists('$(TargetDir)RSSAM.API.dll')"
           Text="RSSAM.API.dll was not copied to the UnitTests output directory: $(TargetDir)" />
  </Target>
</Project>
