<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RSSAM.API</RootNamespace>
    <AssemblyName>RSSAM.API</AssemblyName>
    <AssemblyTitle>RSSAM.API</AssemblyTitle>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Company>Daniel Riggi (riggi89)</Company>
    <Authors>Daniel Riggi (riggi89); Rick (Gibbed)</Authors>
    <Description>Steam native API bridge for RSSAM, derived from Steam Achievement Manager by Rick (Gibbed).</Description>
    <Copyright>RSSAM modifications Copyright © 2026 Daniel Riggi (riggi89). Original Steam Achievement Manager Copyright © 2024 Rick (Gibbed).</Copyright>
    <RepositoryUrl>https://github.com/gibbed/SteamAchievementManager/</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
  </PropertyGroup>
</Project>
