<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RSSAM</RootNamespace>
    <AssemblyName>RSSAM.Core</AssemblyName>
    <AssemblyTitle>RSSAM.Core</AssemblyTitle>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Company>Daniel Riggi (riggi89)</Company>
    <Authors>Daniel Riggi (riggi89); Rick (Gibbed)</Authors>
    <Description>Core models, services, search contracts and Steam schema support for RSSAM.</Description>
    <Copyright>RSSAM modifications Copyright © 2026 Daniel Riggi (riggi89). Original Steam Achievement Manager Copyright © 2024 Rick (Gibbed).</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RSSAM.API\RSSAM.API.csproj"
                      AdditionalProperties="BuildingForUnitTests=$(BuildingForUnitTests)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\Resources\*.json">
      <LogicalName>RSSAM.Localization.Resources.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <None Update="Localization\Resources\*.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          TargetPath="Localization\Resources\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
