<Page
    x:Class="RSSAM.Views.ManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:tv="using:WinUI.TableView"
    Background="{ThemeResource AppContentBrush}">

    <Grid x:Name="RootGrid" Background="Transparent" SizeChanged="RootGrid_SizeChanged">
        <Grid x:Name="GamesView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="GamesHeaderGrid" Grid.Row="0" Margin="24,20,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="GamesTitleText"
                               Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="GamesSubtitleText"
                               Margin="0,4,0,0"
                               Foreground="{ThemeResource AppSecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="GamesFavoritesOnlyButton"
                                  Width="36"
                                  Height="36"
                                  Padding="0"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Style="{StaticResource ToolbarToggleButtonStyle}"
                                  Click="GamesFavoritesOnlyButton_Click">
                        <FontIcon Glyph="&#xE734;" FontSize="15" />
                    </ToggleButton>

                    <ToggleButton x:Name="GamesGridViewButton"
                                  Width="36"
                                  Height="36"
                                  Padding="0"
                                  IsChecked="True"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Style="{StaticResource ToolbarToggleButtonStyle}"
                                  Click="GamesGridViewButton_Click">
                        <FontIcon Glyph="&#xE80A;" FontSize="15" />
                    </ToggleButton>

                    <ToggleButton x:Name="GamesListViewButton"
                                  Width="36"
                                  Height="36"
                                  Padding="0"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Style="{StaticResource ToolbarToggleButtonStyle}"
                                  Click="GamesListViewButton_Click">
                        <FontIcon Glyph="&#xEA37;" FontSize="15" />
                    </ToggleButton>

                    <ToggleButton x:Name="GamesTableViewButton"
                                  Width="36"
                                  Height="36"
                                  Padding="0"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Style="{StaticResource ToolbarToggleButtonStyle}"
                                  Click="GamesTableViewButton_Click">
                        <FontIcon Glyph="&#xE8A9;" FontSize="15" />
                    </ToggleButton>

                    <ProgressRing x:Name="CatalogProgressRing"
                                  Width="28"
                                  Height="28"
                                  Margin="8,0,0,0"
                                  IsActive="False"
                                  VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <GridView x:Name="GamesGrid"
                          Margin="16,0,16,12"
                          IsItemClickEnabled="True"
                          SelectionMode="Single"
                          ItemClick="Games_ItemClick">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="310" ItemHeight="94" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="294"
                                    Height="82"
                                    Padding="10"
                                    Style="{StaticResource SectionCardStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="128"
                                            Height="48"
                                            CornerRadius="5"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource AppSubtleFillBrush}">
                                        <Image Source="{Binding ImageUrl}" Stretch="Uniform" />
                                    </Border>

                                    <Grid Grid.Column="1">
                                        <StackPanel Margin="0,0,30,0"
                                                    VerticalAlignment="Center"
                                                    Spacing="4">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2" />
                                            <TextBlock Text="{Binding AppIdText}"
                                                       Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                       FontSize="12" />
                                        </StackPanel>

                                        <ToggleButton Width="28"
                                                      Height="28"
                                                      Padding="0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Top"
                                                      HorizontalContentAlignment="Center"
                                                      VerticalContentAlignment="Center"
                                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                                      IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                                      Loaded="FavoriteButton_Loaded">
                                            <FontIcon Glyph="&#xE734;" FontSize="13" />
                                        </ToggleButton>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <ListView x:Name="GamesList"
                          Margin="16,0,16,12"
                          Visibility="Collapsed"
                          IsItemClickEnabled="True"
                          SelectionMode="Single"
                          ItemClick="Games_ItemClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border MinHeight="76"
                                    Padding="12,8"
                                    Style="{StaticResource SectionCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="160"
                                            Height="60"
                                            CornerRadius="5"
                                            Background="{ThemeResource AppSubtleFillBrush}">
                                        <Image Source="{Binding ImageUrl}" Stretch="Uniform" />
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <ToggleButton Grid.Column="2"
                                                  Width="32"
                                                  Height="32"
                                                  Margin="8,0"
                                                  Padding="0"
                                                  HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  Style="{StaticResource ToolbarToggleButtonStyle}"
                                                  IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                                  Loaded="FavoriteButton_Loaded">
                                        <FontIcon Glyph="&#xE734;" FontSize="14" />
                                    </ToggleButton>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding AppIdText}"
                                               Margin="16,0,4,0"
                                               Foreground="{ThemeResource AppSecondaryTextBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <tv:TableView x:Name="GamesTable"
                              Margin="16,0,16,12"
                              Visibility="Collapsed"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanResizeColumns="False"
                              CanReorderColumns="False"
                              CanSortColumns="False"
                              CanFilterColumns="False"
                              IsItemClickEnabled="True"
                              SelectionMode="Single"
                              SelectionUnit="Row"
                              CornerButtonMode="None"
                              ItemClick="Games_ItemClick">
                    <tv:TableView.Columns>
                        <tv:TableViewTemplateColumn x:Name="FavoriteTableColumn" Width="92">
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton Width="28"
                                                  Height="28"
                                                  Padding="0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  IsChecked="{Binding IsFavorite, Mode=OneWay}"
                                                  IsHitTestVisible="False"
                                                  IsTabStop="False"
                                                  Style="{StaticResource ToolbarToggleButtonStyle}">
                                        <FontIcon Glyph="&#xE734;" FontSize="13" />
                                    </ToggleButton>
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>
                        <tv:TableViewTemplateColumn x:Name="ImageTableColumn" Width="154">
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="128"
                                            Height="48"
                                            CornerRadius="5"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource AppSubtleFillBrush}">
                                        <Image Source="{Binding ImageUrl}" Stretch="Uniform" />
                                    </Border>
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>
                        <tv:TableViewTextColumn x:Name="NameTableColumn"
                                                Width="*"
                                                Binding="{Binding Name, Mode=OneWay}" />
                        <tv:TableViewNumberColumn x:Name="AppIdTableColumn"
                                                  Width="150"
                                                  Binding="{Binding Id, Mode=OneWay}" />
                        <tv:TableViewTextColumn x:Name="TypeTableColumn"
                                                Width="180"
                                                Binding="{Binding Type, Mode=OneWay}" />
                    </tv:TableView.Columns>
                </tv:TableView>
            </Grid>
        </Grid>

        <Grid x:Name="GameDetailView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="GameHeaderPanel"
                        Grid.Row="0"
                        Margin="20,16,20,10"
                        Spacing="2">
                <TextBlock x:Name="SelectedGameTitle"
                           Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="SelectedGameSubtitle"
                           Foreground="{ThemeResource AppSecondaryTextBrush}"
                           FontSize="12" />
            </StackPanel>

            <controls:TabView x:Name="GameTabView"
                              Grid.Row="1"
                              Margin="16,0,16,12"
                              IsAddTabButtonVisible="False"
                              SelectionChanged="GameTabView_SelectionChanged">
                <controls:TabViewItem x:Name="AchievementsTab"
                                      IsClosable="False">
                    <Grid Padding="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    Spacing="8">
                            <TextBlock x:Name="AchievementSummaryText"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center" />

                            <ComboBox x:Name="AchievementStateFilter"
                                      Width="180"
                                      HorizontalAlignment="Left"
                                      SelectedIndex="0"
                                      SelectionChanged="AchievementStateFilter_SelectionChanged">
                                <ComboBoxItem x:Name="AchievementFilterAllItem" />
                                <ComboBoxItem x:Name="AchievementFilterUnlockedItem" />
                                <ComboBoxItem x:Name="AchievementFilterLockedItem" />
                            </ComboBox>
                        </StackPanel>

                        <ListView x:Name="AchievementsList"
                                  Grid.Row="1"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanEdit}"
                                                  VerticalAlignment="Center" />

                                        <Border Grid.Column="1"
                                                Width="48"
                                                Height="48"
                                                CornerRadius="4"
                                                Background="{ThemeResource AppSubtleFillBrush}">
                                            <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                                        </Border>

                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource AppSecondaryTextBrush}" />
                                            <TextBlock Text="{Binding ProtectionText}"
                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                       FontSize="11" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding UnlockText}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{ThemeResource AppSecondaryTextBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </controls:TabViewItem>

                <controls:TabViewItem x:Name="StatisticsTab"
                                      IsClosable="False">
                    <Grid Padding="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock x:Name="StatisticsTitleText" FontWeight="SemiBold" />
                            <TextBlock x:Name="StatisticsHelpText"
                                       Foreground="{ThemeResource AppSecondaryTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <ListView x:Name="StatisticsList"
                                  Grid.Row="1"
                                  SelectionMode="None">
                            <ListView.Header>
                                <Grid Padding="12,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StatisticsColumnNameText" FontWeight="SemiBold" />
                                    <TextBlock x:Name="StatisticsColumnValueText" Grid.Column="1" FontWeight="SemiBold" />
                                    <TextBlock x:Name="StatisticsColumnFlagsText" Grid.Column="2" FontWeight="SemiBold" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Id}"
                                                       Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                       FontSize="12" />
                                        </StackPanel>

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding EditableValue, Mode=TwoWay}"
                                                 IsReadOnly="{Binding IsReadOnly}"
                                                 HorizontalAlignment="Stretch" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Flags}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </controls:TabViewItem>
            </controls:TabView>

            <Grid Grid.Row="2" Margin="20,0,20,16" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressRing x:Name="GameProgressRing"
                              Width="20"
                              Height="20"
                              IsActive="False" />
                <TextBlock x:Name="GameStatusText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource AppSecondaryTextBrush}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
