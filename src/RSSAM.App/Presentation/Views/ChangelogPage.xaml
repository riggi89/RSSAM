<Page
    x:Class="RSSAM.Views.ChangelogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppContentBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ContentPanel"
                    Margin="32"
                    MaxWidth="1040"
                    HorizontalAlignment="Left"
                    Spacing="16">
            <StackPanel Spacing="4" HorizontalAlignment="Left">
                <TextBlock x:Name="TitleText"
                           Text="Changelog"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Left" />
                <TextBlock x:Name="SubtitleText"
                           Text="Release history of the WinUI 3 version of RSSAM."
                           Foreground="{ThemeResource AppSecondaryTextBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel x:Name="EntriesPanel"
                        HorizontalAlignment="Stretch"
                        Spacing="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
