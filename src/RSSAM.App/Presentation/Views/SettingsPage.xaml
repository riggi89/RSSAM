<Page
    x:Class="RSSAM.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localControls="using:RSSAM.Controls"
    Background="{ThemeResource AppContentBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid x:Name="SettingsRootGrid"
              Padding="28,18,28,40"
              HorizontalAlignment="Stretch">
            <StackPanel MaxWidth="1120"
                        HorizontalAlignment="Stretch"
                        Spacing="10">
                <StackPanel Spacing="4" Margin="0,0,0,8" HorizontalAlignment="Left">
                    <TextBlock x:Name="SettingsTitleText"
                               Style="{StaticResource TitleTextBlockStyle}"
                               HorizontalAlignment="Left" />
                    <TextBlock x:Name="SettingsSubtitleText"
                               Foreground="{ThemeResource AppSecondaryTextBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Left" />
                </StackPanel>

                <TextBlock x:Name="AppearanceSectionText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,8,0,2"
                           HorizontalAlignment="Left" />

                <localControls:SettingsRow x:Name="LanguageSettingsRow" IconGlyph="&#xE8C1;">
                    <localControls:SettingsRow.ActionContent>
                        <ComboBox x:Name="LanguageComboBox"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="SettingsControl_SelectionChanged">
                            <ComboBoxItem x:Name="LanguageGermanItem" Content="Deutsch" Tag="de-DE" />
                            <ComboBoxItem x:Name="LanguageEnglishItem" Content="English" Tag="en-US" />
                        </ComboBox>
                    </localControls:SettingsRow.ActionContent>
                </localControls:SettingsRow>

                <localControls:SettingsRow x:Name="ThemeSettingsRow" IconGlyph="&#xE790;">
                    <localControls:SettingsRow.ActionContent>
                        <ComboBox x:Name="ThemeComboBox"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="SettingsControl_SelectionChanged">
                            <ComboBoxItem x:Name="ThemeSystemItem" Content="System" Tag="System" />
                            <ComboBoxItem x:Name="ThemeLightItem" Content="Hell" Tag="Light" />
                            <ComboBoxItem x:Name="ThemeDarkItem" Content="Dunkel" Tag="Dark" />
                        </ComboBox>
                    </localControls:SettingsRow.ActionContent>
                </localControls:SettingsRow>

                <localControls:SettingsRow x:Name="BackdropSettingsRow" IconGlyph="&#xE771;">
                    <localControls:SettingsRow.ActionContent>
                        <ComboBox x:Name="BackdropComboBox"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="SettingsControl_SelectionChanged">
                            <ComboBoxItem Content="Mica" Tag="Mica" />
                            <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                            <ComboBoxItem x:Name="BackdropStandardItem" Tag="Standard" />
                        </ComboBox>
                    </localControls:SettingsRow.ActionContent>
                </localControls:SettingsRow>

                <localControls:SettingsRow x:Name="CompactNavigationSettingsRow" IconGlyph="&#xE700;">
                    <localControls:SettingsRow.ActionContent>
                        <ToggleSwitch x:Name="CompactNavigationToggle"
                                      HorizontalAlignment="Left"
                                      Toggled="SettingsControl_Toggled" />
                    </localControls:SettingsRow.ActionContent>
                </localControls:SettingsRow>

                <TextBlock x:Name="WindowSectionText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,14,0,2"
                           HorizontalAlignment="Left" />

                <localControls:SettingsRow x:Name="StatusBarSettingsRow" IconGlyph="&#xE7F4;">
                    <localControls:SettingsRow.ActionContent>
                        <ToggleSwitch x:Name="StatusBarToggle"
                                      HorizontalAlignment="Left"
                                      Toggled="SettingsControl_Toggled" />
                    </localControls:SettingsRow.ActionContent>
                </localControls:SettingsRow>

                <localControls:SettingsRow x:Name="StartMaximizedSettingsRow" IconGlyph="&#xE923;">
                    <localControls:SettingsRow.ActionContent>
                        <ToggleSwitch x:Name="StartMaximizedToggle"
                                      HorizontalAlignment="Left"
                                      Toggled="SettingsControl_Toggled" />
                    </localControls:SettingsRow.ActionContent>
                </localControls:SettingsRow>

                <localControls:SettingsRow x:Name="RememberWindowSettingsRow" IconGlyph="&#xE81E;">
                    <localControls:SettingsRow.ActionContent>
                        <ToggleSwitch x:Name="RememberWindowToggle"
                                      HorizontalAlignment="Left"
                                      Toggled="SettingsControl_Toggled" />
                    </localControls:SettingsRow.ActionContent>
                </localControls:SettingsRow>

                <TextBlock x:Name="StartSectionText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,14,0,2"
                           HorizontalAlignment="Left" />

                <localControls:SettingsRow x:Name="LoadGamesSettingsRow" IconGlyph="&#xE896;">
                    <localControls:SettingsRow.ActionContent>
                        <ToggleSwitch x:Name="LoadGamesOnStartupSwitch"
                                      HorizontalAlignment="Left"
                                      Toggled="SettingsControl_Toggled" />
                    </localControls:SettingsRow.ActionContent>
                </localControls:SettingsRow>

                <localControls:SettingsRow x:Name="ConfirmStoreSettingsRow" IconGlyph="&#xE73E;">
                    <localControls:SettingsRow.ActionContent>
                        <ToggleSwitch x:Name="ConfirmBeforeStoreSwitch"
                                      HorizontalAlignment="Left"
                                      Toggled="SettingsControl_Toggled" />
                    </localControls:SettingsRow.ActionContent>
                </localControls:SettingsRow>

                <localControls:SettingsRow x:Name="ConfirmResetSettingsRow" IconGlyph="&#xE7A7;">
                    <localControls:SettingsRow.ActionContent>
                        <ToggleSwitch x:Name="ConfirmBeforeResetSwitch"
                                      HorizontalAlignment="Left"
                                      Toggled="SettingsControl_Toggled" />
                    </localControls:SettingsRow.ActionContent>
                </localControls:SettingsRow>

                <localControls:SettingsRow x:Name="SuccessSettingsRow" IconGlyph="&#xE73E;">
                    <localControls:SettingsRow.ActionContent>
                        <ToggleSwitch x:Name="ShowSuccessMessagesSwitch"
                                      HorizontalAlignment="Left"
                                      Toggled="SettingsControl_Toggled" />
                    </localControls:SettingsRow.ActionContent>
                </localControls:SettingsRow>

                <localControls:SettingsRow x:Name="StatEditSettingsRow" IconGlyph="&#xE70F;">
                    <localControls:SettingsRow.ActionContent>
                        <ToggleSwitch x:Name="EnableStatisticsEditingByDefaultSwitch"
                                      HorizontalAlignment="Left"
                                      Toggled="SettingsControl_Toggled" />
                    </localControls:SettingsRow.ActionContent>
                </localControls:SettingsRow>

                <TextBlock x:Name="ConfigurationSectionText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,14,0,2"
                           HorizontalAlignment="Left" />

                <localControls:SettingsRow x:Name="ConfigSettingsRow" IconGlyph="&#xE8B7;">
                    <localControls:SettingsRow.ActionContent>
                        <StackPanel HorizontalAlignment="Left" Spacing="8">
                            <TextBlock x:Name="SettingsPathText"
                                       MaxWidth="760"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource AppSecondaryTextBrush}"
                                       HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        Spacing="8">
                                <Button x:Name="OpenSettingsFileButton"
                                        Style="{StaticResource ToolbarCommandButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Click="OpenSettingsFile_Click" />
                                <Button x:Name="OpenSettingsFolderButton"
                                        Style="{StaticResource ToolbarCommandButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Click="OpenSettingsFolder_Click" />
                            </StackPanel>
                        </StackPanel>
                    </localControls:SettingsRow.ActionContent>
                </localControls:SettingsRow>

                <TextBlock x:Name="AboutSectionText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,14,0,2"
                           HorizontalAlignment="Left" />

                <Border Style="{StaticResource SectionCardStyle}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8" HorizontalAlignment="Left">
                        <Grid ColumnSpacing="10" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7FC;" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="1" HorizontalAlignment="Left">
                                <TextBlock Text="RSSAM" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                <TextBlock Text="Riggi's Steam Achievement Manager"
                                           Foreground="{ThemeResource AppSecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="AboutVersionText" TextWrapping="Wrap" HorizontalAlignment="Left" />
                        <TextBlock x:Name="AboutDescriptionText"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource AppSecondaryTextBrush}"
                                   HorizontalAlignment="Left" />

                        <StackPanel Spacing="2" HorizontalAlignment="Left">
                            <TextBlock x:Name="OriginalProjectText" FontWeight="SemiBold" HorizontalAlignment="Left" />
                            <HyperlinkButton Content="gibbed/SteamAchievementManager"
                                             NavigateUri="https://github.com/gibbed/SteamAchievementManager"
                                             Padding="0"
                                             HorizontalAlignment="Left" />
                        </StackPanel>

                        <TextBlock x:Name="LicenseTitleText"
                                   FontWeight="SemiBold"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Left" />
                        <TextBlock x:Name="LicenseDescriptionText"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource AppSecondaryTextBrush}"
                                   HorizontalAlignment="Left" />
                        <TextBlock x:Name="CopyrightText"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource AppSecondaryTextBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}" HorizontalAlignment="Stretch">
                    <Grid ColumnSpacing="10" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE946;" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Left">
                            <TextBlock x:Name="AboutNoteTitleText" FontWeight="SemiBold" HorizontalAlignment="Left" />
                            <TextBlock x:Name="AboutNoteMessageText"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource AppSecondaryTextBrush}"
                                       HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
