<UserControl
    x:Class="RSSAM.Controls.SettingsRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="16,12"
            CornerRadius="8"
            Background="{ThemeResource AppCardBackgroundBrush}"
            BorderBrush="{ThemeResource AppCardBorderBrush}"
            BorderThickness="1"
            HorizontalAlignment="Stretch">
        <Grid ColumnSpacing="14" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Width="36" Height="36" VerticalAlignment="Top">
                <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}" FontSize="18" />
            </Grid>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Spacing="2">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left" />
                <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                           Opacity="0.62"
                           FontSize="12"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left" />
            </StackPanel>

            <ContentPresenter Grid.Row="1"
                              Grid.Column="1"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Content="{x:Bind ActionContent, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
