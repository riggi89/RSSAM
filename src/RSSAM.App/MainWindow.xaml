<Window
    x:Class="RSSAM.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:RSSAM.Views"
    Title="RSSAM - Riggi's Steam Achievement Manager">

    <Grid x:Name="RootLayout"
          Background="{ThemeResource AppShellBackgroundBrush}"
          SizeChanged="RootLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Padding="8,0,0,0"
              Background="{ThemeResource AppTitleBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeadingColumn" Width="420" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarCaptionColumn" Width="140" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                <Button x:Name="TitleBarBackButton"
                        Style="{StaticResource TitleBarSmallIconButtonStyle}"
                        Visibility="Collapsed"
                        Click="TitleBarBackButton_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                </Button>

                <Button x:Name="TitleBarPaneButton"
                        Style="{StaticResource TitleBarSmallIconButtonStyle}"
                        Click="TitleBarPaneButton_Click">
                    <FontIcon Glyph="&#xE700;" FontSize="12" />
                </Button>

                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center">
                    <Image Width="18"
                           Height="18"
                           Source="ms-appx:///Assets/RSSAM-AppIcon-24.png"
                           Stretch="Uniform" />
                    <TextBlock Text="RSSAM"
                               FontWeight="SemiBold"
                               FontSize="14"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ProductNameText"
                               Text="Riggi's Steam Achievement Manager"
                               Foreground="{ThemeResource AppSecondaryTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <AutoSuggestBox x:Name="UniversalSearchBox"
                            Grid.ColumnSpan="3"
                            Width="540"
                            Margin="20,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            QueryIcon="Find"
                            TextChanged="UniversalSearchBox_TextChanged" />
        </Grid>

        <views:ShellPage x:Name="ShellPageHost" Grid.Row="1" />
    </Grid>
</Window>
