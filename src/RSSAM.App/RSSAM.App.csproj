<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RSSAM</RootNamespace>
    <AssemblyName>RSSAM</AssemblyName>
    <AssemblyTitle>RSSAM - Riggi's Steam Achievement Manager</AssemblyTitle>
    <ApplicationIcon>Assets\RSSAM-AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxGeneratePriEnabled>true</AppxGeneratePriEnabled>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Company>Daniel Riggi (riggi89)</Company>
    <Authors>Daniel Riggi (riggi89); Rick (Gibbed)</Authors>
    <Product>RSSAM - Riggi's Steam Achievement Manager</Product>
    <Description>Modern WinUI 3 frontend for managing Steam achievements and statistics. Derived from Steam Achievement Manager by Rick (Gibbed).</Description>
    <Copyright>RSSAM modifications Copyright © 2026 Daniel Riggi (riggi89). Original Steam Achievement Manager Copyright © 2024 Rick (Gibbed).</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="WinUI.TableView" Version="1.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RSSAM.Core\RSSAM.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\RSSAM-AppIcon-24.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="RSSAM.CHANGELOG.md" />
    <None Include="..\..\LICENSE.md" Link="LICENSE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\NOTICE.md" Link="NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\ARCHITECTURE.md" Link="ARCHITECTURE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\PROJECTS.md" Link="PROJECTS.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Unpackaged WinUI publishes do not consistently copy the generated project
    resource index. The application cannot resolve compiled XAML without it.
  -->
  <Target Name="CopyProjectPriToPublishDirectory"
          AfterTargets="Publish"
          Condition="'$(PublishDir)' != '' and '$(ProjectPriFullPath)' != '' and Exists('$(ProjectPriFullPath)')">
    <Copy SourceFiles="$(ProjectPriFullPath)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
