<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="TitleBarSmallIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="FloatingInfoBarStyle" TargetType="InfoBar">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10,12,10" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="FloatingInfoBarInfoStyle"
           TargetType="InfoBar"
           BasedOn="{StaticResource FloatingInfoBarStyle}">
        <Setter Property="Background" Value="{ThemeResource AppInfoBarInfoBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppInfoBarInfoBorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppInfoBarInfoForegroundBrush}" />
    </Style>

    <Style x:Key="FloatingInfoBarSuccessStyle"
           TargetType="InfoBar"
           BasedOn="{StaticResource FloatingInfoBarStyle}">
        <Setter Property="Background" Value="{ThemeResource AppInfoBarSuccessBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppInfoBarSuccessBorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppInfoBarSuccessForegroundBrush}" />
    </Style>

    <Style x:Key="FloatingInfoBarWarningStyle"
           TargetType="InfoBar"
           BasedOn="{StaticResource FloatingInfoBarStyle}">
        <Setter Property="Background" Value="{ThemeResource AppInfoBarWarningBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppInfoBarWarningBorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppInfoBarWarningForegroundBrush}" />
    </Style>

    <Style x:Key="FloatingInfoBarErrorStyle"
           TargetType="InfoBar"
           BasedOn="{StaticResource FloatingInfoBarStyle}">
        <Setter Property="Background" Value="{ThemeResource AppInfoBarErrorBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppInfoBarErrorBorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppInfoBarErrorForegroundBrush}" />
    </Style>

    <Style x:Key="AppContentDialogStyle" TargetType="ContentDialog">
        <Setter Property="Background" Value="{ThemeResource AppDialogBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppDialogForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppDialogBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="AppDialogMessageTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppDialogForegroundBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="MaxWidth" Value="540" />
    </Style>

    <Style x:Key="ToolbarCommandButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolbarAutoSuggestTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TitleBarSearchBoxStyle" TargetType="AutoSuggestBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="MaxWidth" Value="540" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextBoxStyle" Value="{StaticResource ToolbarAutoSuggestTextBoxStyle}" />
    </Style>
</ResourceDictionary>
