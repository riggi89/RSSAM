<Page
    x:Class="RSSAM.CardIdler.Views.CardIdlerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:RSSAM.CardIdler.Converters"
    xmlns:tv="using:WinUI.TableView"
    x:Name="RootPage"
    NavigationCacheMode="Required">

    <Page.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NotNullToVisibility" />
        <conv:InverseNullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid Margin="28,22,28,14" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="PageTitleText" Text="Card Idler" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="PageSubtitleText" Margin="0,4,0,0"
                           Text="Farm remaining Steam trading-card drops without launching each game."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Padding="12,6" CornerRadius="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE701;" FontSize="13" />
                    <TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AccountName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                <Grid Margin="28,8,28,12" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel><TextBlock x:Name="BatchLabelText" Text="READY TO IDLE" Style="{ThemeResource CaptionTextBlockStyle}" /><TextBlock Text="{Binding NowPlaying.Count}" FontSize="28" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                        <StackPanel><TextBlock x:Name="DropsLeftLabelText" Text="DROPS LEFT" Style="{ThemeResource CaptionTextBlockStyle}" /><TextBlock Text="{Binding TotalDrops}" FontSize="28" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <StackPanel><TextBlock x:Name="CardsEarnedLabelText" Text="CARDS EARNED" Style="{ThemeResource CaptionTextBlockStyle}" /><TextBlock Text="{Binding CardsEarned}" FontSize="28" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                        <StackPanel><TextBlock x:Name="SessionLabelText" Text="SESSION" Style="{ThemeResource CaptionTextBlockStyle}" /><TextBlock Text="{Binding Uptime}" FontSize="26" FontWeight="SemiBold" FontFamily="Consolas" /></StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="28,0,28,20" ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="5*" /><ColumnDefinition Width="3*" MinWidth="300" /></Grid.ColumnDefinitions>

                    <Grid>
                        <GridView x:Name="TileGamesView" ItemsSource="{Binding FilteredGames, ElementName=RootPage}"
                                  IsItemClickEnabled="True" ItemClick="GameList_ItemClick" SelectionMode="Single">
                            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="270" ItemHeight="136" /></ItemsPanelTemplate></GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="258" Height="124" Margin="4" CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            ToolTipService.ToolTip="{Binding Name}">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <Image Source="{Binding HeaderUrl}" Stretch="UniformToFill" />
                                            <Border Grid.Row="1" Padding="10,6">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding HoursText}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Padding="8,3" CornerRadius="10" Background="{ThemeResource AccentFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DropsRemaining}" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <ListView x:Name="ListGamesView" Visibility="Collapsed"
                                  ItemsSource="{Binding FilteredGames, ElementName=RootPage}"
                                  IsItemClickEnabled="True" ItemClick="GameList_ItemClick" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="72" Padding="8" ColumnSpacing="12" ToolTipService.ToolTip="{Binding Name}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border CornerRadius="5"><Image Source="{Binding HeaderUrl}" Stretch="UniformToFill" /></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding HoursText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" MinWidth="72" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DropsRemaining}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Text="Drops" Style="{ThemeResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid x:Name="DetailGamesPanel" Visibility="Collapsed">
                            <tv:TableView x:Name="DetailGamesView"
                                          ItemsSource="{Binding FilteredGames, ElementName=RootPage}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanResizeColumns="False"
                                          CanReorderColumns="False"
                                          CanSortColumns="False"
                                          CanFilterColumns="False"
                                          IsItemClickEnabled="True"
                                          SelectionMode="Single"
                                          SelectionUnit="Row"
                                          CornerButtonMode="None"
                                          ItemClick="GameList_ItemClick">
                                <tv:TableView.Columns>
                                    <tv:TableViewTemplateColumn x:Name="DetailImageColumn" Width="142">
                                        <tv:TableViewTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Width="116"
                                                        Height="44"
                                                        CornerRadius="4"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        ToolTipService.ToolTip="{Binding Name}">
                                                    <Image Source="{Binding HeaderUrl}" Stretch="UniformToFill" />
                                                </Border>
                                            </DataTemplate>
                                        </tv:TableViewTemplateColumn.CellTemplate>
                                    </tv:TableViewTemplateColumn>
                                    <tv:TableViewTextColumn x:Name="DetailGameColumn"
                                                            Width="*"
                                                            Binding="{Binding Name, Mode=OneWay}" />
                                    <tv:TableViewNumberColumn x:Name="DetailAppIdColumn"
                                                              Width="100"
                                                              Binding="{Binding AppId, Mode=OneWay}" />
                                    <tv:TableViewNumberColumn x:Name="DetailDropsColumn"
                                                              Width="90"
                                                              Binding="{Binding DropsRemaining, Mode=OneWay}" />
                                    <tv:TableViewTextColumn x:Name="DetailPlaytimeColumn"
                                                            Width="120"
                                                            Binding="{Binding HoursText, Mode=OneWay}" />
                                </tv:TableView.Columns>
                            </tv:TableView>
                        </Grid>
                    </Grid>

                    <Border Grid.Column="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="SelectGameHintText" Text="Select a game to see its details."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding Selected, Converter={StaticResource NullToVisibility}}" />
                            <Grid Visibility="{Binding Selected, Converter={StaticResource NotNullToVisibility}}">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="150" /></Grid.RowDefinitions>
                                <ScrollViewer DataContext="{Binding Selected}">
                                    <StackPanel>
                                        <Image Height="145" Source="{Binding HeaderUrl}" Stretch="UniformToFill" />
                                        <StackPanel Margin="16">
                                            <TextBlock Text="{Binding Name}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Developers}" Margin="0,4,0,0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Genres}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <Grid Margin="0,14,0,0" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock x:Name="DetailDropsLabelText" Text="Card drops" Style="{ThemeResource CaptionTextBlockStyle}" /><TextBlock Text="{Binding DropsRemaining}" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                                                <StackPanel Grid.Column="1"><TextBlock x:Name="DetailPlaytimeLabelText" Text="Playtime" Style="{ThemeResource CaptionTextBlockStyle}" /><TextBlock Text="{Binding HoursText}" FontWeight="SemiBold" /></StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding Description}" Margin="0,14,0,0" TextWrapping="Wrap" />
                                            <Button x:Name="OpenStoreButton" Content="Open store page" Margin="0,14,0,0" HorizontalAlignment="Left" Click="OpenStoreButton_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                                <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <TextBlock x:Name="ActivityLabelText" Text="Activity" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Status}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="210" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ListView Grid.Row="1" ItemsSource="{Binding Activity}" IsHitTestVisible="False">
                                            <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVisibility}}" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Border Width="450" Padding="30" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <StackPanel Visibility="{Binding QrLoginVisible, Converter={StaticResource InverseBoolToVisibility}}">
                            <FontIcon Glyph="&#xE72E;" FontSize="36" HorizontalAlignment="Left" />
                            <TextBlock x:Name="LoginTitleText" Text="Steam sign-in" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,16,0,0" />
                            <TextBlock x:Name="LoginDescriptionText" Text="Sign in to scan your remaining card drops and start idling."
                                       Margin="0,4,0,18" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="UsernameLabelText" Text="Steam account name" Style="{ThemeResource CaptionTextBlockStyle}" />
                            <TextBox x:Name="UserBox" Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding NotBusy}" />
                            <TextBlock x:Name="PasswordLabelText" Text="Password" Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,12,0,0" />
                            <PasswordBox x:Name="PasswordBox" IsEnabled="{Binding NotBusy}" KeyDown="PasswordBox_KeyDown" />
                            <CheckBox x:Name="StaySignedInCheckBox" Content="Stay signed in (encrypted on this PC)" IsChecked="{Binding StayLoggedIn, Mode=TwoWay}" Margin="0,12,0,0" />
                            <InfoBar IsOpen="True" Severity="Error" IsClosable="False" Message="{Binding LoginError}" Margin="0,12,0,0"
                                     Visibility="{Binding LoginError, Converter={StaticResource StringToVisibility}}" />
                            <Button x:Name="LoginButton" Content="Sign in" Style="{ThemeResource AccentButtonStyle}" Margin="0,18,0,0"
                                    HorizontalAlignment="Stretch" Click="LoginButton_Click" IsEnabled="{Binding NotBusy}" />
                            <Grid Margin="0,12,0,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="LoginOrText" Grid.Column="1" Text="or" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border Grid.Column="2" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <Button x:Name="QrLoginButton" Content="Sign in with QR code" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                    Command="{Binding QrLoginCommand}" IsEnabled="{Binding NotBusy}" />
                            <TextBlock Text="{Binding Status}" Margin="0,10,0,0" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding QrLoginVisible, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock x:Name="QrTitleText" Text="Sign in with Steam Mobile" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="QrDescriptionText" Text="Open Steam Mobile, scan this code and confirm the sign-in."
                                       Margin="0,6,0,14" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Border Width="248" Height="248" Padding="8" CornerRadius="8" Background="White" HorizontalAlignment="Center">
                                <Image x:Name="QrCodeImage" Stretch="Uniform" />
                            </Border>
                            <ProgressBar Margin="0,14,0,0" IsIndeterminate="True" />
                            <TextBlock Text="{Binding QrStatus}" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="QrCancelButton" Content="Cancel" Margin="0,16,0,0" HorizontalAlignment="Stretch" Command="{Binding CancelQrLoginCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Visibility="{Binding GuardVisible, Converter={StaticResource BoolToVisibility}}" Background="#AA000000">
                <Border Width="390" Padding="28" CornerRadius="12" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="GuardTitleText" Text="Steam Guard" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Text="{Binding GuardHint}" Margin="0,6,0,14" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="GuardCodeBox" Text="{Binding GuardCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="8" CharacterCasing="Upper" FontFamily="Consolas" FontSize="24" TextAlignment="Center" KeyDown="GuardCodeBox_KeyDown" />
                        <TextBlock x:Name="GuardWrongText" Text="The code was not accepted. Enter the newest code."
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding GuardWrong, Converter={StaticResource BoolToVisibility}}" />
                        <Grid Margin="0,18,0,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="GuardCancelButton" Content="Cancel" Command="{Binding CancelGuardCommand}" HorizontalAlignment="Stretch" />
                            <Button x:Name="GuardConfirmButton" Grid.Column="1" Content="Confirm" Command="{Binding SubmitGuardCommand}"
                                    Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <InfoBar IsOpen="{Binding ToastVisible}" Severity="Success" IsClosable="False" Title="Card drop" Message="{Binding Toast}"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24" />
        </Grid>
    </Grid>
</Page>
